# ===== PartsQA 環境變數範本 =====
# 複製為 .env 後填入實際值；.env 不可提交到版控、不可打包。

# --- LLM（問答機器人呼叫模型時必要）---
# Anthropic API Key（https://console.anthropic.com 取得）
ANTHROPIC_API_KEY=input_api_key
# 選填：模型端點。留空 = Anthropic 官方端點；
# 若使用 Microsoft Foundry，填資源網址（到 /anthropic 為止），程式會自動改用 Foundry 客戶端
PQA_LLM_BASE_URL=
# 模型（預設全部使用最省 token 的 Haiku）
# 可用：claude-haiku-5-5 / claude-sonnet-5-5 / claude-opus-5-5
PQA_MODEL_AGENT=claude-haiku-5-5
# PQA_ROUTING=auto 時，應變／建議題與失敗備援改用此模型（例如 claude-sonnet-5-5）
PQA_MODEL_ESCALATE=claude-haiku-5-5
# fixed = 一律使用 PQA_MODEL_AGENT（最省）；auto = 依題型路由到 PQA_MODEL_ESCALATE
PQA_ROUTING=fixed
# 評測比較用的輕量模型
PQA_MODEL_LIGHT=claude-haiku-5-5
# 推理強度 low / medium / high（空白 = 模型預設）
PQA_EFFORT=medium
# 選填：逾時秒數、重試次數、單次輸出上限、Agent 最大輪數
PQA_LLM_TIMEOUT=120
PQA_LLM_MAX_RETRIES=2
PQA_LLM_MAX_TOKENS=8000
PQA_AGENT_MAX_TURNS=6
# 測試用：1 = 使用 Mock LLM，不呼叫真實 API
PQA_MOCK_LLM=0
# 示範模式：1 = 登入頁提供一鍵角色登入與範例問題；未設定 API Key 時重播評測中的真實回答（公開展示用，正式環境請設 0）
PQA_DEMO_MODE=0
# 示範模式且有 API Key 時，每次登入最多即時提問幾題（控制費用）
PQA_DEMO_MAX_QUESTIONS=10

# --- 資料與設定位置（相對路徑以專案根目錄為基準）---
# 6 個 CSV 所在資料夾（唯讀）；預設為 data/
PQA_DATA_DIR=data
# 領域設定（檔名、料號格式、產品線、工廠、物料類別、基準日）
PQA_DOMAIN_FILE=config/domain.json
# 選填：清理後資料庫、應用程式資料庫（帳號／稽核／審核）、報告輸出位置
PQA_CLEAN_DB=data/processed/partsqa_clean.db
PQA_APP_DB=data/app/partsqa_app.db
PQA_REPORT_DIR=data/processed

# --- 帳號 ---
# scripts/init_users.py 建立帳號時使用的初始密碼（至少 8 碼；以 bcrypt 雜湊後存入資料庫）
PQA_SEED_PASSWORD=input_initial_password
# 選填：命令列工具（scripts/ask.py、scripts/run_clean.py）登入密碼；MCP 伺服器登入帳密
PQA_LOGIN_PASSWORD=
PQA_MCP_USER=
PQA_MCP_PASSWORD=
